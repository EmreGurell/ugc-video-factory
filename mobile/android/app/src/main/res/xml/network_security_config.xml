<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Sadece yerel geliştirme backend'i için şifresiz (http://) trafiğe izin verir.
         Android emülatöründe host makine 10.0.2.2 üzerinden erişilir. Gerçek üretim
         backend'i (Railway, https://) bu konfigürasyondan etkilenmez. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.24.41.46</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
