generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  jobs              Job[]
  reference_photos  ReferencePhoto[]
  refresh_tokens    RefreshToken[]
  device_tokens     DeviceToken[]
  memberships       Membership[]

  @@map("users")
}

// Bir organizasyon "workspace" — job/referans kütüphanesi görünürlük sınırı.
// Her kullanıcı kayıt olurken otomatik olarak kendi kişisel organizasyonuna
// owner olarak eklenir; birden fazla organizasyona üye olunabilir.
model Organization {
  id                     String    @id @default(uuid())
  name                   String
  active_plan_id         String?
  active_plan            Plan?     @relation(fields: [active_plan_id], references: [key])
  credits_remaining      Int       @default(0)
  credits_period_start   DateTime?
  revenuecat_app_user_id String?
  created_at             DateTime  @default(now())

  memberships         Membership[]
  jobs                Job[]
  reference_photos    ReferencePhoto[]
  refresh_tokens      RefreshToken[]
  provider_cost_events ProviderCostEvent[]

  @@map("organizations")
}

// Sabit, elle seed edilen plan seviyeleri (Free/Starter/Pro) — RevenueCat
// ürünleriyle eşleşir (Faz 4). `key` insan-okunur kimlik, mağaza ürün id'si değil.
model Plan {
  key                     String   @id
  name                    String
  monthly_credit_allowance Int
  price_usd               Float?
  revenuecat_product_ids  String[]
  created_at              DateTime @default(now())

  organizations Organization[]

  @@map("plans")
}

// RevenueCat webhook idempotency: aynı event tekrar gönderilirse (RevenueCat
// retry yapabilir) ikinci kez işlenmesin diye event.id burada tutulur.
model RevenueCatWebhookEvent {
  id           String   @id
  event_type   String
  organization_id String?
  created_at   DateTime @default(now())

  @@map("revenuecat_webhook_events")
}

// Her gerçek (ücretli) sağlayıcı çağrısından sonra bir kayıt — marj/maliyet
// analitiği içindir, pipeline'ı mid-flight durdurmaz. Kredi düşme/iade
// Job.credits_charged üzerinden ayrı çalışır (bkz. jobs.service.ts, pipeline.service.ts).
model ProviderCostEvent {
  id              String   @id @default(uuid())
  job_id          String
  job             Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  provider        String
  operation       String
  unit_cost_usd   Float
  created_at      DateTime @default(now())

  @@index([organization_id])
  @@index([job_id])
  @@map("provider_cost_events")
}

model Membership {
  id              String   @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role            String   @default("owner")
  created_at      DateTime @default(now())

  @@unique([organization_id, user_id])
  @@index([user_id])
  @@map("memberships")
}

model DeviceToken {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("android")
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("device_tokens")
}

// organization_id: token'ın basıldığı andaki aktif organizasyon — refresh
// edildiğinde kullanıcı hangi org'u seçmiş olursa olsun o bağlam korunur.
model RefreshToken {
  id              String    @id @default(uuid())
  user_id         String
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  token_hash      String    @unique
  expires_at      DateTime
  revoked_at      DateTime?
  created_at      DateTime  @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

model Job {
  id                  String   @id @default(uuid())
  user_id             String
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization_id     String
  organization        Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  status              String   @default("pending")
  content_type        String   @default("ugc_selfie")
  product_name        String?
  video_brief         String?
  product_research    String?
  draft_script        String?
  approved_script     String?
  prompt_character    String?
  prompt_script       String?
  aspect_ratio        String   @default("9:16")
  scene_count         Int      @default(3)
  video_style         String   @default("dynamic")
  voice_language      String   @default("tr")
  voice_gender        String   @default("female")
  reference_image_url String?
  reference_tags      String[]
  music_mode          String   @default("none")
  music_style         String?
  image_model         String   @default("nano_banana")
  video_model         String   @default("kling_standard")
  image_url           String?
  scenes              Json?
  clip_urls           String[]
  final_video_url     String?
  error_message       String?
  actual_cost_usd     Float    @default(0)
  credits_charged     Int      @default(0)
  credits_refunded    Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  cost_events ProviderCostEvent[]

  @@index([user_id])
  @@index([organization_id])
  @@map("jobs")
}

model ReferencePhoto {
  id              String   @id @default(uuid())
  user_id         String
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tag             String
  url             String
  description     String?
  created_at      DateTime @default(now())

  @@index([user_id, tag])
  @@index([organization_id, tag])
  @@map("reference_photos")
}
