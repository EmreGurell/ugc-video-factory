ANTHROPIC_API_KEY=
REDIS_URL=redis://localhost:6379
PORT=3000

# Railway Postgres (yerelde docker compose'daki postgres servisiyle test edilebilir)
DATABASE_URL=postgresql://ugc:ugc@localhost:5432/ugc?schema=public

# JWT access token imzalama anahtari (rastgele uzun bir string uret)
JWT_ACCESS_SECRET=

# Cloudflare R2 (S3 uyumlu) — dashboard'dan alinir
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ugc-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# kie.ai — video (Kling/Sora2/Veo3), gorsel (Nano Banana) ve AI muzik (Suno)
KIE_API_KEY=

# ElevenLabs dogrudan API — OPSIYONEL: bos birakilirsa TTS kie.ai uzerinden calisir
ELEVENLABS_API_KEY=

# Firebase Admin SDK — OPSIYONEL: yoksa push bildirimleri sessizce devre disi kalir
# Yerel gelistirme: dosya yolu (bkz. FIREBASE_SERVICE_ACCOUNT_PATH)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Railway/production: dosya sistemi kalici olmadigindan JSON'un kendisi env olarak verilir
# (Firebase servis hesabi JSON dosyasinin TAM icerigi, tek satir)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
